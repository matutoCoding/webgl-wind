{
  "name": "webgl-wind",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "eslint src/*.js demo/index.js data/prepare.js",
    "serve": "st -nc -i index.html",
    "start": "run-p serve watch"
  },
  "keywords": [],
  "author": "Vladimir Agafonkin",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "pngjs": "^3.4.0",
    "rollup": "^4.24.0",
    "st": "^2.0.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "es6": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 2018
    },
    "globals": {
      "dat": false,
      "WindGL": false
    },
    "rules": {
      "no-var": 2,
      "prefer-const": 2,
      "semi": [2, "always"],
      "indent": [2, 4],
      "no-unused-vars": 1
    }
  }
}
